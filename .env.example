# Copy this file to ".env" (same folder) and fill it in. Never share or commit .env.

# ---- Discord (voice-bot) ----------------------------------------------------
# Create the bot and copy its token from the Discord Developer Portal > Bot.
# Copy the application ID from General Information and your server ID from Discord.
# Never commit or share real values from your .env file.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# How long someone must be silent before the final audio chunk is flushed (ms).
# Lower = faster subtitles but more sentence splits. Higher = cleaner but laggier.
SILENCE_MS=500
MIN_UTTERANCE_MS=500
# Maximum size of each chunk during continuous speech. The stream keeps running.
MAX_UTTERANCE_MS=4000
# Search the last 1200ms of a chunk for a quiet split point.
SEGMENT_SEARCH_MS=1200
# Do not split before the chunk reaches 2500ms.
SEGMENT_MIN_MS=2500
# PCM RMS threshold for considering a window quiet (16-bit audio scale).
SEGMENT_QUIET_RMS=700

# Show the original text under the translation (true/false)
SHOW_ORIGINAL=true

# Time captions remain in chat before deleted. 
# Set MESSAGE_DELETE_SECONDS=0 to turn it off. User messages are never deleted.
MESSAGE_DELETE_SECONDS=300

# TESTING ONLY: save every utterance as a WAV in voice-bot/recordings (true/false).
# Leave false normally. Your friends' voices are not stored.
RECORD_WAV=false

# Where the Python service listens
SERVICE_URL=http://127.0.0.1:8000

# Maximum utterances the Discord bot processes at once per server.
# Different speakers can run concurrently; each speaker's messages stay ordered.
MAX_CONCURRENT_UTTERANCES=3

# ---- Overlay relay ----------------------------------------------------------
# Optional: forwards transcripts directly to connected overlay apps.
# Each friend gets a separate label:random-token credential; remove one to revoke it.
# Generate a token with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Example format (replace every example value; never commit real credentials):
OVERLAY_RELAY_PORT=8765
OVERLAY_RELAY_TOKENS=

# Optional: Cloudflare named-tunnel token for the Docker 'tunnel' profile.
# Keep empty unless you have configured a named tunnel in Cloudflare.
CLOUDFLARE_TUNNEL_TOKEN=

# ---- Python service ---------------------------------------------------------
# Whisper. GPU (your RTX 3090): cuda + float16. Lower beam size improves latency.
# Use beam size 1 for faster live captions; increase to 3-5 if accuracy needs it.
WHISPER_BEAM_SIZE=1
# No working CUDA yet?  cpu + int8 (use a smaller model)
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=cuda
WHISPER_COMPUTE=float16

# Maximum simultaneous Whisper jobs in the Python service.
# Start at 2 on the RTX 3090; reduce to 1 if GPU memory/performance worsens.
MAX_CONCURRENT_TRANSCRIPTIONS=2

# Maximum target-language translations running at the same time.
# Additional languages wait in a small worker queue; start at 2 for local Ollama.
MAX_CONCURRENT_TRANSLATIONS=2

# Which translator: none | google | openai
# Docker Compose overrides LLM_BASE_URL to http://ollama:11434 for its bundled Ollama.
# Docker defaults an empty LLM_MODEL to translategemma:4b and pulls it on first startup.
#   none   = transcription only (start here to test)
#   google = Google Cloud Translation API (needs GOOGLE_API_KEY)
#   openai = any OpenAI-compatible endpoint (OpenAI, local Ollama, llama.cpp, LM Studio)
TRANSLATOR=none

GOOGLE_API_KEY=

# For TRANSLATOR=openai. Local Ollama example:
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=
LLM_API_KEY=ollama
