# Docker deployment additions. Keep actual secrets in the untracked root .env.
# Add this only after creating a named Cloudflare Tunnel:
CLOUDFLARE_TUNNEL_TOKEN=

# Compose supplies internal service addresses automatically:
# SERVICE_URL=http://whisper:8000
# LLM_BASE_URL=http://ollama:11434
# SERVICE_HOST=0.0.0.0
# OVERLAY_RELAY_HOST=0.0.0.0
